@page "/search-results"
@rendermode InteractiveServer
@using BaRemake.Data.Repositories
@using BaRemake.Shared.DTOs
@using BaRemake.Shared.Enums
@using BaRemake.Web.Services
@inject BookingSessionService BookingSession
@inject IFlightRepository FlightRepo
@inject NavigationManager Nav

<PageTitle>Flight Results – BaRemake</PageTitle>

<div class="container py-4">
    <!-- Step indicator -->
    <BookingSteps CurrentStep="1" IsReturn="@BookingSession.Session.SearchRequest.IsReturnTrip" />

    <!-- Summary bar -->
    <div class="ba-results-bar">
        <div class="ba-results-bar__route">
            <strong>@BookingSession.Session.SearchRequest.OriginCode</strong>
            <span class="mx-2">→</span>
            <strong>@BookingSession.Session.SearchRequest.DestinationCode</strong>
        </div>
        <div class="ba-results-bar__details">
            <span>@BookingSession.Session.SearchRequest.DepartureDate.ToString("ddd d MMM yyyy")</span>
            <span class="mx-2">·</span>
            <span>@BookingSession.Session.SearchRequest.TotalPassengers passenger@(BookingSession.Session.SearchRequest.TotalPassengers > 1 ? "s" : "")</span>
            <span class="mx-2">·</span>
            <span>@BookingSession.Session.SearchRequest.CabinClass</span>
        </div>
        <a href="/" class="btn btn-ba-outline btn-sm">Modify search</a>
    </div>

    @if (IsLoading)
    {
        <div class="ba-loading">
            <div class="ba-loading__spinner"></div>
            <p>Searching for the best flights...</p>
        </div>
    }
    else if (!OutboundFlights.Any())
    {
        <div class="ba-no-results">
            <div class="ba-no-results__icon">✈</div>
            <h3>No flights found</h3>
            <p>No flights available for your chosen date. Try a different date or route.</p>
            <a href="/" class="btn btn-ba-primary">New search</a>
        </div>
    }
    else
    {
        <div class="ba-search-layout">
            <!-- Filter sidebar -->
            <aside class="ba-filter-panel">
                <div class="ba-filter-panel__header">
                    <h4>Filter results</h4>
                    @if (HasActiveFilters)
                    {
                        <button class="ba-filter-clear" @onclick="ClearFilters">Clear all</button>
                    }
                </div>

                <!-- Airline filter -->
                @if (AvailableAirlines.Count > 1)
                {
                    <div class="ba-filter-section">
                        <h5>Airlines</h5>
                        @foreach (var airline in AvailableAirlines)
                        {
                            <label class="ba-filter-checkbox">
                                <input type="checkbox"
                                       checked="@IsAirlineSelected(airline.Code)"
                                       @onchange="() => ToggleAirline(airline.Code)" />
                                <span class="ba-filter-checkbox__airline">
                                    @if (!string.IsNullOrEmpty(airline.LogoUrl))
                                    {
                                        <img src="@airline.LogoUrl" alt="@airline.Name" class="ba-filter-airline-logo" />
                                    }
                                    else
                                    {
                                        <span class="ba-filter-airline-dot" style="background: @airline.BrandColor"></span>
                                    }
                                    @airline.Name
                                </span>
                            </label>
                        }
                    </div>
                }

                <!-- Price filter -->
                <div class="ba-filter-section">
                    <h5>Max price</h5>
                    <div class="ba-price-range">
                        <input type="range" min="@MinPrice" max="@MaxPrice" step="10"
                               @bind="PriceFilterMax" @bind:event="oninput"
                               class="ba-range-slider" />
                        <span class="ba-price-range__label">Up to £@PriceFilterMax</span>
                    </div>
                </div>

                <!-- Departure time filter -->
                <div class="ba-filter-section">
                    <h5>Departure time</h5>
                    <div class="ba-time-filter">
                        <button class="ba-time-btn @(TimeFilter == "any" ? "active" : "")" @onclick="() => TimeFilter = "any"">Any</button>
                        <button class="ba-time-btn @(TimeFilter == "morning" ? "active" : "")" @onclick="() => TimeFilter = "morning"">Morning<br/><small>06:00–12:00</small></button>
                        <button class="ba-time-btn @(TimeFilter == "afternoon" ? "active" : "")" @onclick="() => TimeFilter = "afternoon"">Afternoon<br/><small>12:00–18:00</small></button>
                        <button class="ba-time-btn @(TimeFilter == "evening" ? "active" : "")" @onclick="() => TimeFilter = "evening"">Evening<br/><small>18:00+</small></button>
                    </div>
                </div>
            </aside>

            <!-- Main results column -->
            <div class="ba-results-main">
                <!-- Airline chips row -->
                @if (AvailableAirlines.Count > 1)
                {
                    <div class="ba-airline-chips">
                        <button class="ba-airline-chip @(SelectedAirlines.Count == 0 ? "active" : "")"
                                @onclick="ClearAirlineFilter">
                            All airlines
                            <span class="ba-airline-chip__count">@CurrentSourceFlights.Count</span>
                        </button>
                        @foreach (var airline in AvailableAirlines)
                        {
                            var count = CurrentSourceFlights.Count(f => f.AirlineCode == airline.Code);
                            <button class="ba-airline-chip @(IsAirlineSelected(airline.Code) ? "active" : "")"
                                    style="@(IsAirlineSelected(airline.Code) ? $"background:{airline.BrandColor}; border-color:{airline.BrandColor}; color:#fff" : $"border-color:{airline.BrandColor}; color:{airline.BrandColor}")"
                                    @onclick="() => ToggleAirline(airline.Code)">
                                @if (!string.IsNullOrEmpty(airline.LogoUrl))
                                {
                                    <img src="@airline.LogoUrl" alt="" class="ba-airline-chip__logo" />
                                }
                                @airline.Code
                                <span class="ba-airline-chip__count">@count</span>
                            </button>
                        }
                    </div>
                }

                <!-- Header -->
                <div class="ba-flight-list-header">
                    <h2>
                        @if (BookingSession.Session.SearchRequest.IsReturnTrip && ShowingReturn)
                        {
                            <span>Choose your return flight</span>
                        }
                        else
                        {
                            <span>Choose your outbound flight</span>
                        }
                    </h2>
                    <span class="ba-flight-count">
                        @FilteredFlights.Count flight@(FilteredFlights.Count != 1 ? "s" : "") found
                        @if (AvailableAirlines.Count > 1)
                        {
                            <span class="ba-flight-count__airlines"> across @AvailableAirlines.Count airlines</span>
                        }
                    </span>
                </div>

                <!-- Sort bar -->
                <div class="ba-sort-bar">
                    <span>Sort by:</span>
                    <button class="ba-sort-btn @(SortBy == "time" ? "active" : "")" @onclick="() => SortBy = "time"">Departure time</button>
                    <button class="ba-sort-btn @(SortBy == "price" ? "active" : "")" @onclick="() => SortBy = "price"">Price</button>
                    <button class="ba-sort-btn @(SortBy == "duration" ? "active" : "")" @onclick="() => SortBy = "duration"">Duration</button>
                    <button class="ba-sort-btn @(SortBy == "airline" ? "active" : "")" @onclick="() => SortBy = "airline"">Airline</button>
                </div>

                @foreach (var flight in FilteredFlights)
                {
                    <FlightCard Flight="@flight"
                                SelectedClass="@BookingSession.Session.SearchRequest.CabinClass"
                                IsSelected="@(SelectedFlightId == flight.Id)"
                                OnSelect="() => SelectFlight(flight)" />
                }

                @if (!FilteredFlights.Any())
                {
                    <div class="ba-no-results ba-no-results--filtered">
                        <p>No flights match your filters. <button class="ba-link-btn" @onclick="ClearFilters">Clear filters</button></p>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private List<FlightDto> OutboundFlights = new();
    private List<FlightDto> ReturnFlights = new();
    private bool IsLoading = true;
    private bool ShowingReturn;
    private string SortBy = "time";
    private int SelectedFlightId;

    // Filters
    private HashSet<string> SelectedAirlines = new();
    private int PriceFilterMax = 9999;
    private int MinPrice = 0;
    private int MaxPrice = 9999;
    private string TimeFilter = "any";

    private List<AirlineFilterDto> AvailableAirlines = new();

    private List<FlightDto> CurrentSourceFlights => ShowingReturn ? ReturnFlights : OutboundFlights;

    private List<FlightDto> FilteredFlights
    {
        get
        {
            var flights = CurrentSourceFlights;
            var cls = BookingSession.Session.SearchRequest.CabinClass;

            // Airline filter
            if (SelectedAirlines.Count > 0)
                flights = flights.Where(f => SelectedAirlines.Contains(f.AirlineCode)).ToList();

            // Price filter
            if (PriceFilterMax < MaxPrice)
                flights = flights.Where(f =>
                {
                    var p = f.PriceForClass(cls);
                    return p.HasValue && p.Value <= PriceFilterMax;
                }).ToList();

            // Time filter
            flights = TimeFilter switch
            {
                "morning" => flights.Where(f => f.DepartureTime.Hour >= 6 && f.DepartureTime.Hour < 12).ToList(),
                "afternoon" => flights.Where(f => f.DepartureTime.Hour >= 12 && f.DepartureTime.Hour < 18).ToList(),
                "evening" => flights.Where(f => f.DepartureTime.Hour >= 18).ToList(),
                _ => flights
            };

            // Sort
            return SortBy switch
            {
                "price" => flights.OrderBy(f => f.PriceForClass(cls)).ToList(),
                "duration" => flights.OrderBy(f => f.DurationMinutes).ToList(),
                "airline" => flights.OrderBy(f => f.AirlineName).ToList(),
                _ => flights.OrderBy(f => f.DepartureTime).ToList()
            };
        }
    }

    private bool HasActiveFilters => SelectedAirlines.Count > 0 || PriceFilterMax < MaxPrice || TimeFilter != "any";

    private bool IsAirlineSelected(string code) => SelectedAirlines.Contains(code);

    private void ToggleAirline(string code)
    {
        if (SelectedAirlines.Contains(code))
            SelectedAirlines.Remove(code);
        else
            SelectedAirlines.Add(code);
    }

    private void ClearAirlineFilter() => SelectedAirlines.Clear();

    private void ClearFilters()
    {
        SelectedAirlines.Clear();
        PriceFilterMax = MaxPrice;
        TimeFilter = "any";
    }

    protected override async Task OnInitializedAsync()
    {
        var req = BookingSession.Session.SearchRequest;
        if (string.IsNullOrEmpty(req.OriginCode))
        {
            Nav.NavigateTo("/");
            return;
        }

        OutboundFlights = await FlightRepo.SearchFlightsAsync(
            req.OriginCode, req.DestinationCode,
            req.DepartureDate, req.TotalPassengers, req.CabinClass);

        if (req.IsReturnTrip && req.ReturnDate.HasValue)
            ReturnFlights = await FlightRepo.SearchFlightsAsync(
                req.DestinationCode, req.OriginCode,
                req.ReturnDate.Value, req.TotalPassengers, req.CabinClass);

        // Build airline list from outbound results
        AvailableAirlines = OutboundFlights
            .Select(f => new AirlineFilterDto
            {
                Code = f.AirlineCode,
                Name = f.AirlineName,
                LogoUrl = f.AirlineLogoUrl,
                BrandColor = f.AirlineBrandColor
            })
            .DistinctBy(a => a.Code)
            .OrderBy(a => a.Name)
            .ToList();

        // Set price range
        var cls = req.CabinClass;
        var prices = OutboundFlights
            .Select(f => f.PriceForClass(cls))
            .Where(p => p.HasValue)
            .Select(p => (int)p!.Value)
            .ToList();

        if (prices.Any())
        {
            MinPrice = prices.Min();
            MaxPrice = prices.Max();
            PriceFilterMax = MaxPrice;
        }

        IsLoading = false;
    }

    private void SelectFlight(FlightDto flight)
    {
        SelectedFlightId = flight.Id;
        var req = BookingSession.Session.SearchRequest;

        if (!ShowingReturn)
        {
            BookingSession.SelectOutboundFlight(flight);

            if (req.IsReturnTrip && ReturnFlights.Any())
            {
                ShowingReturn = true;
                SelectedFlightId = 0;
            }
            else
            {
                BookingSession.InitialisePassengers();
                Nav.NavigateTo("/select-seats");
            }
        }
        else
        {
            BookingSession.SelectReturnFlight(flight);
            BookingSession.InitialisePassengers();
            Nav.NavigateTo("/select-seats");
        }
    }
}
