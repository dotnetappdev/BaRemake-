@using BaRemake.Shared.DTOs
@using BaRemake.Shared.Enums

<div class="ba-flight-card @(IsSelected ? "ba-flight-card--selected" : "")"
     style="@(IsSelected ? $"border-left: 4px solid {Flight.AirlineBrandColor};" : "")"
     @onclick="OnSelect">

    <!-- Airline header band -->
    <div class="ba-flight-card__airline" style="background: @Flight.AirlineBrandColor10">
        <div class="ba-airline-badge">
            @if (!string.IsNullOrEmpty(Flight.AirlineLogoUrl))
            {
                <img src="@Flight.AirlineLogoUrl" alt="@Flight.AirlineName" class="ba-airline-logo" />
            }
            else
            {
                <span class="ba-airline-code-badge" style="background: @Flight.AirlineBrandColor; color: #fff;">
                    @Flight.AirlineCode
                </span>
            }
            <span class="ba-airline-name">@Flight.AirlineName</span>
        </div>
        @if (Flight.IsLowCost)
        {
            <span class="ba-tag ba-tag--lowcost">Low-cost</span>
        }
    </div>

    <div class="ba-flight-card__main">
        <!-- Times -->
        <div class="ba-flight-card__times">
            <div class="ba-flight-time">
                <span class="ba-flight-time__time">@Flight.DepartureTime.ToString("HH:mm")</span>
                <span class="ba-flight-time__code">@Flight.OriginCode</span>
                <span class="ba-flight-time__city">@Flight.OriginCity</span>
            </div>
            <div class="ba-flight-card__route-line">
                <div class="ba-route-line">
                    <div class="ba-route-line__dot"></div>
                    <div class="ba-route-line__line"></div>
                    <div class="ba-route-line__plane" style="color: @Flight.AirlineBrandColor">✈</div>
                    <div class="ba-route-line__line"></div>
                    <div class="ba-route-line__dot"></div>
                </div>
                <span class="ba-flight-duration">@Flight.DurationDisplay</span>
                <span class="ba-flight-nonstop">Nonstop</span>
            </div>
            <div class="ba-flight-time ba-flight-time--right">
                <span class="ba-flight-time__time">@Flight.ArrivalTime.ToString("HH:mm")</span>
                <span class="ba-flight-time__code">@Flight.DestinationCode</span>
                <span class="ba-flight-time__city">@Flight.DestinationCity</span>
            </div>
        </div>

        <!-- Details -->
        <div class="ba-flight-card__details">
            <span class="ba-flight-number">@Flight.FlightNumber</span>
            <span class="ba-flight-aircraft">@Flight.AircraftModel</span>
            @if (Flight.Status != BaRemake.Shared.Enums.FlightStatus.Scheduled)
            {
                <span class="ba-flight-status ba-flight-status--@Flight.Status.ToString().ToLower()">
                    @Flight.Status
                </span>
            }
        </div>
    </div>

    <!-- Prices by cabin -->
    <div class="ba-flight-card__prices">
        @if (Flight.EconomyPrice.HasValue && Flight.AvailableEconomySeats > 0)
        {
            <div class="ba-price-cell @(SelectedClass == SeatClass.Economy ? "ba-price-cell--active" : "")"
                 style="@(SelectedClass == SeatClass.Economy ? $"border-color: {Flight.AirlineBrandColor};" : "")">
                <span class="ba-price-cell__class">Economy</span>
                <span class="ba-price-cell__price">£@Flight.EconomyPrice.Value.ToString("N0")</span>
                <span class="ba-price-cell__seats">@Flight.AvailableEconomySeats seats left</span>
            </div>
        }
        @if (Flight.BusinessPrice.HasValue && Flight.AvailableBusinessSeats > 0)
        {
            <div class="ba-price-cell @(SelectedClass == SeatClass.Business ? "ba-price-cell--active" : "")"
                 style="@(SelectedClass == SeatClass.Business ? $"border-color: {Flight.AirlineBrandColor};" : "")">
                <span class="ba-price-cell__class">Business</span>
                <span class="ba-price-cell__price">£@Flight.BusinessPrice.Value.ToString("N0")</span>
                <span class="ba-price-cell__seats">@Flight.AvailableBusinessSeats seats left</span>
            </div>
        }
        @if (Flight.FirstPrice.HasValue && Flight.AvailableFirstSeats > 0)
        {
            <div class="ba-price-cell @(SelectedClass == SeatClass.First ? "ba-price-cell--active" : "")"
                 style="@(SelectedClass == SeatClass.First ? $"border-color: {Flight.AirlineBrandColor};" : "")">
                <span class="ba-price-cell__class">First</span>
                <span class="ba-price-cell__price">£@Flight.FirstPrice.Value.ToString("N0")</span>
                <span class="ba-price-cell__seats">@Flight.AvailableFirstSeats seats left</span>
            </div>
        }

        <div class="ba-flight-card__select-btn">
            @if (IsSelected)
            {
                <button class="btn btn-ba-selected" style="background: @Flight.AirlineBrandColor">✓ Selected</button>
            }
            else
            {
                <button class="btn btn-ba-primary" style="background: @Flight.AirlineBrandColor; border-color: @Flight.AirlineBrandColor">Select</button>
            }
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public FlightDto Flight { get; set; } = null!;
    [Parameter] public SeatClass SelectedClass { get; set; } = SeatClass.Economy;
    [Parameter] public bool IsSelected { get; set; }
    [Parameter] public EventCallback OnSelect { get; set; }

    // 10% opacity hex for header band
    private string AirlineBrandColor10 => Flight.AirlineBrandColor + "1a";
}
